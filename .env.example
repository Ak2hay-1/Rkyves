# Resend API key for contact form emails
# Sign up at https://resend.com (free tier available)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email address where contact form submissions are sent
CONTACT_EMAIL=sales@rkyves.com

# Optional: verified sender address in Resend (defaults to onboarding@resend.dev for testing)
# RESEND_FROM_EMAIL=Rkyves Website <hello@rkyves.com>

# Production site URL (used in sitemap, metadata, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://rkyves.com

# Optional: Cal.com or Calendly embed URL for /contact#book
# NEXT_PUBLIC_CAL_URL=https://cal.com/your-link

# Optional: forward leads to Make / Zapier / CRM webhook
# LEAD_WEBHOOK_URL=https://hooks.example.com/lead

# Optional analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=rkyves.com
