# Resend API key for contact form emails
# Sign up at https://resend.com (free tier available)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email address where contact form submissions are sent
CONTACT_EMAIL=sales@rkyves.com

# Optional: verified sender address in Resend (defaults to onboarding@resend.dev for testing)
# RESEND_FROM_EMAIL=Rkyves Website <hello@rkyves.com>

# Production site URL (used in sitemap, metadata, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://rkyves.com

# Optional: Cal.com or Calendly embed URL for /contact#book
# NEXT_PUBLIC_CAL_URL=https://cal.com/your-link

# Optional: forward leads to Make / Zapier / CRM webhook
# LEAD_WEBHOOK_URL=https://hooks.example.com/lead

# Optional analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=rkyves.com

# ─── Rkyves OS (Internal Client Management System) ───
# PostgreSQL connection (Neon recommended: https://neon.tech)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Encryption key for credentials vault (minimum 32 characters)
ENCRYPTION_KEY=change-this-to-a-random-32-char-secret-key

# Optional: protect cron automation endpoint
# CRON_SECRET=your-cron-secret

# ─── Phase 3: Notifications ───
# Email uses existing RESEND_API_KEY above
# RESEND_FROM_EMAIL=Rkyves OS <hello@rkyves.com>

# WhatsApp Option A: webhook (Make, Zapier, n8n)
# WHATSAPP_WEBHOOK_URL=https://hooks.example.com/whatsapp

# WhatsApp Option B: Meta Cloud API
# WHATSAPP_API_URL=https://graph.facebook.com/v18.0/YOUR_PHONE_NUMBER_ID/messages
# WHATSAPP_ACCESS_TOKEN=your-meta-access-token

# ─── Phase 3: File Storage ───
# Vercel Blob (production document uploads)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Neon project: frosty-smoke-38850346
# Get connection string from https://console.neon.tech

# ─── Cullinos Integration ───
# Cullinos API base URL (NestJS)
# CULLINOS_API_URL=http://localhost:3000/api
# Shared secret for tenant provisioning
# CULLINOS_PROVISION_KEY=change-me-internal-provision-key
# Webhook secret for Cullinos → Rkyves events
# CULLINOS_WEBHOOK_SECRET=change-me-webhook-secret
# RKYVES_WEBHOOK_SECRET=change-me-webhook-secret

# ─── Razorpay Subscriptions (Cullinos billing) ───
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
